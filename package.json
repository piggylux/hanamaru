{
  "name": "hanamaru",
  "version": "0.1.0",
  "private": true,
  "description": "Organize and read the doujins on your computer, in the browser",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1"
  },
  "devDependencies": {
    "@lucide/svelte": "1.74.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "daisyui": "^5.8.1",
    "fflate": "^0.8.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "packageManager": "bun@1.4.3"
}
